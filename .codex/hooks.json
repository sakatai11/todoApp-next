{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "set -o pipefail; content=$(jq -r '(.tool_input.new_string // .tool_input.content) // empty'); if printf '%s\\n' \"$content\" | grep -qiE '(//|#|/\\*).*\\b(TODO|FIXME|HACK|XXX)\\b'; then printf '\\u26a0\\ufe0f  先送りコード(TODO/FIXME/HACK)が検出されました。今すぐ実装してください。\\n' >&2; exit 2; fi; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(test(\"\\\\.(?:tsx?|jsx?|json|md)$\"))' | tee /dev/stderr | xargs -r npx prettier --write"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y gh-setup-hooks",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
